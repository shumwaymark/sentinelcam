%YAML 1.0
---
# storage_analysis.yaml
# Storage analysis report configuration for this data sink
# Generated by Ansible template

# Identity of this data sink (used as key in report data)
datasink_name: {{ inventory_hostname }}

# Root paths to analyze
sentinelcam_root: {{ sentinelcam_data_path }}

# Where to write the report
report_path: {{ sentinelcam_directories.storage_report }}

# Disk device or mount point for capacity metrics
disk_path: {{ storage_analysis_disk_path | default(sentinelcam_data_path) }}

# Number of days of daily history to retain in the report
# Older daily detail rolls off; the data itself is unaffected
report_history_days: {{ storage_analysis_history_days | default(365) }}
