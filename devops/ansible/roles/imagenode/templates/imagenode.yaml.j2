# Settings file imagenode.yaml -- SentinelCam version 7
# Generated by Ansible for {{ inventory_hostname }}
# Node: {{ imagenode_config.node_name }}
---
node:
  name: {{ imagenode_config.node_name }}
  heartbeat: {{ imagenode_config.heartbeat | default(10) }}
  REP_watcher: False
  queuemax: 50
  send_type: jpg
  send_threading: False
  print_settings: False

{% set datasink = sentinelcam_outposts[inventory_hostname].datasink | default('data1') %}
hub_address:
  H1: tcp://{{ datasink }}:{{ sentinelcam_ports.imagehub_zmq }}

cameras:
{% for camera_id, camera in imagenode_config.cameras.items() %}
  {{ camera_id }}:
    viewname: {{ camera.viewname }}
    resolution: {{ camera.resolution | string }}
    framerate: {{ camera.framerate }}
{% if camera_id.startswith('P') %}
    vflip: {{ camera.vflip | default(false) }}
    threaded_read: False
{% endif %}
    detectors:
        outpost:
{% if camera_id.startswith('O') and camera.detector.encoder is defined %}
            encoder: {{ camera.detector.encoder }}
{% endif %}
            publish_cam: {{ sentinelcam_ports.imagenode_publisher }}
            publish_log: {{ sentinelcam_ports.imagenode_logging }}
            logconfig:
                version: 1
                handlers:
                    zmq:
                        class: zmq.log.handlers.PUBHandler
                        interface_or_socket: tcp://*:{{ sentinelcam_ports.imagenode_logging }}
                        root_topic: {{ imagenode_config.node_name }}
                        level: {{ 'DEBUG' if (camera.debug_mode | default(debug_mode)) else 'INFO' }}
                root:
                    handlers: [zmq]
                    level: {{ 'DEBUG' if (camera.debug_mode | default(debug_mode)) else 'INFO' }}
            # camwatcher: tcp://{{ datasink }}:{{ sentinelcam_ports.camwatcher_control }}
            spyglass: {{ camera.resolution | string }}
            detectobjects: {{ camera.detector.detectobjects | default('none') }}
            accelerator: {{ camera.detector.accelerator | default('none') }}
            # Seconds an unanswered SpyGlass inference may stand before the child is
            # presumed wedged and replaced. A USB accelerator can stop answering with
            # no error, no exception and no kernel event -- there is nothing to catch,
            # only a reply that never comes -- so a deadline is the sole detector.
            # 0 disables. Must clear a cold start (model load + 3s settle).
            spyglass_timeout: {{ camera.detector.spyglass_timeout | default(30) }}
{% if camera.detector.tracker is defined and camera.detector.tracker is mapping %}
            # §4.10: host-tracker config (a dict) opts this node into the unified
            # lifecycle. Lives at the detector level for ALL node types (OAK + picamera);
            # the legacy `tracker: none` string flag is retired. Absent => publish-only.
            tracker:
{{ camera.detector.tracker | to_nice_yaml(indent=2) | indent(14, first=true) }}
{% endif %}
{% if camera.detector.interesting_objects is defined %}
            interesting_objects: {{ camera.detector.interesting_objects | list }}
{% endif %}
{% if camera.detector.motion_params is defined %}
            motion_params:
                varThreshold: {{ camera.detector.motion_params.varThreshold }}
                detectShadows: {{ camera.detector.motion_params.detectShadows | lower }}
                history: {{ camera.detector.motion_params.history }}
                minContourW: {{ camera.detector.motion_params.minContourW }}
                minContourH: {{ camera.detector.motion_params.minContourH }}
                gaussianBlur: {{ camera.detector.motion_params.gaussianBlur }}
{% endif %}
{% if camera.detector.roi is defined %}
            ROI: {{ camera.detector.roi }}
{% endif %}
{% if camera.detector.depthai is defined %}
            depthai:
               nn_archive: {{ mobilenet_depthai_model }}
               crop_publish: {{ sentinelcam_ports.imagenode_crops }}
{% if camera.detector.depthai.lookback_frames is defined %}
               lookback_frames: {{ camera.detector.depthai.lookback_frames }}
{% endif %}
{% if camera.detector.depthai.oak_pipeline is defined %}
               oak_pipeline:
{{ camera.detector.depthai.oak_pipeline | to_nice_yaml(indent=2) | indent(18, first=true) }}
{% endif %}
{% endif %}
{% if camera.detector.sentinel_tasks is defined %}
            sentinel_tasks:
{% for detection, task in camera.detector.sentinel_tasks.items() %}
                {{ detection }}: {{ task }}
{% endfor %}
{% endif %}
{% if camera.detector.detectobjects == 'mobilenetssd' %}
            mobilenetssd:
                confidence: {{ mobilenet_confidence }}
{% if camera.detector.accelerator == 'coral' %}
                edgetpu_model: {{ mobilenet_edgetpu_model }}
                model_labels: {{ mobilenet_edgetpu_labels }}
{% else %}
                prototxt_path: {{ mobilenet_prototxt }}
                model_path: {{ mobilenet_model }}
                target: {% if camera.detector.accelerator == 'ncs2' %}myriad{% else %}cpu{% endif %}
{% endif %}
{% endif %}
{% endfor %}
