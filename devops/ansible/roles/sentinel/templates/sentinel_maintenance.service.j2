# sentinel maintenance service unit file
# SentinelCam Ansible Template

[Unit]
Description=Sentinel Daily Maintenance
Wants=sentinel_maintenance.timer

[Service]
Type=oneshot
User={{ sentinelcam_user }}
WorkingDirectory={{ sentinel_install_path }}
ExecStart={{ sentinel_venv_path }}/bin/python -u {{ sentinel_install_path }}/sentinel_maintenance.py

[Install]
WantedBy=multi-user.target
